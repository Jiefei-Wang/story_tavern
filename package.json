{
  "name": "story_tavern",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:ts": "tsc --noEmit",
    "check:test": "tsx --test tests/**/*.test.ts",
    "check:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run check:ts && npm run check:csp && npm run check:rust",
    "build:exe": "tauri build --no-bundle",
    "build:installer": "tauri build",
    "check:csp": "node --disallow-code-generation-from-strings --import tsx --test tests/**/*.test.ts",
    "eval:narrator": "tsx scripts/narrator_e2e_eval.ts",
    "eval:character-schema": "tsx scripts/character_schema_playtest.ts",
    "eval:character-generation": "tsx scripts/character_schema_generation_playtest.ts",
    "eval:behavior": "tsx scripts/behavior_playtest.ts",
    "eval:behavior:config": "tsx scripts/prepare_behavior_config.ts",
    "eval:refusal:config": "tsx scripts/prepare_refusal_config.ts",
    "eval:refusal": "tsx scripts/refusal_detector_eval.ts",
    "eval:refusal:probes": "tsx scripts/safety_refusal_probes.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@xyflow/react": "^12.11.6",
    "ajv": "^8.20.0",
    "fast-json-patch": "^3.1.1",
    "jsonschema": "^1.5.0",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "zod": "^4.6.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
